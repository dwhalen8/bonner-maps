{
  "name": "bonner-bounds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "data": "node scripts/fetch-parcels.mjs && node scripts/build-tiles.mjs",
    "data:fetch": "node scripts/fetch-parcels.mjs",
    "data:tiles": "node scripts/build-tiles.mjs",
    "docker:build": "docker build -t bonner-bounds .",
    "docker:run": "docker run --rm -p 8080:80 bonner-bounds"
  },
  "dependencies": {
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-clip": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/polygon-to-line": "^7.4.0",
    "maplibre-gl": "^5.7.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
