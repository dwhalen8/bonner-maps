{
  "name": "bonner-bounds-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:better-sqlite3 && mkdir -p dist/migrations && cp migrations/*.sql dist/migrations/",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
